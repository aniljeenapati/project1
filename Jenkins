pipeline {
    agent any
    parameters {
        string(name: 'CLUSTER_NAME', defaultValue: 'my-cluster', description: 'The GKE cluster name')
        string(name: 'ZONE', defaultValue: 'us-west1', description: 'The GCP zone')
        string(name: 'PROJECT_ID', defaultValue: 'anil-449609', description: 'The GCP project ID')
        string(name: 'GIT_BRANCH', defaultValue: 'main', description: 'The GitHub branch to build')
    }
    environment {
        DOCKER_IMAGE_TAG = "sekhar1913/demo:${env.BUILD_ID}"
    }
    stages {
        stage('Git Checkout') {
            steps {
                git url: 'https://github.com/aniljeenapati/project1.git', branch: params.GIT_BRANCH
            }
        }
        stage('Build Docker Image') {
            steps {
                sh "docker build -t ${DOCKER_IMAGE_TAG} ."
            }
        }
        stage('Push Docker Image') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dc', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
                    sh """
                    echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin
                    docker push ${DOCKER_IMAGE_TAG}
                    """
                }
            }
        }
        stage('Terraform Init') {
            steps {
                sh 'terraform init'
            }
        }
        stage('Terraform Apply') {
            steps {
                withCredentials([file(credentialsId: 'gcp-sa', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
                    sh 'terraform apply -auto-approve'
                }
            }
        }
        stage('Deploy to GKE') {
            steps {
                withCredentials([file(credentialsId: 'gcp-sa', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
                    // Authenticate and get credentials for GKE cluster
                    sh 'gcloud auth activate-service-account --key-file=$GOOGLE_APPLICATION_CREDENTIALS'
                    sh "gcloud container clusters get-credentials ${params.CLUSTER_NAME} --zone ${params.ZONE} --project ${params.PROJECT_ID}"

                    sh "sed -i 's/tagversion/${env.BUILD_ID}/g' deploy.yaml"
                    sh 'kubectl apply -f deploy.yaml'
                }
            }
        }
        stage('Install Prometheus and Grafana') {
            steps {
                withCredentials([file(credentialsId: 'gcp-sa', variable: 'GOOGLE_APPLICATION_CREDENTIALS')]) {
                    // Authenticate and get credentials for GKE cluster (already done in Deploy to GKE stage)
                    sh 'gcloud auth activate-service-account --key-file=$GOOGLE_APPLICATION_CREDENTIALS'
                    sh "gcloud container clusters get-credentials ${params.CLUSTER_NAME} --zone ${params.ZONE} --project ${params.PROJECT_ID}"
                    
                    // Install Prometheus and Grafana using Helm
                    sh """
                    helm repo add prometheus-community https://prometheus-community.github.io/helm-charts
                    helm repo update
                    """
                    
                    // Create the monitoring namespace
                    sh """
                    kubectl create namespace monitoring || echo 'Monitoring namespace already exists'
                    """
                    
                    // Install Prometheus and Grafana in the monitoring namespace
                    sh """
                    helm install prometheus prometheus-community/kube-prometheus-stack --namespace monitoring
                    """
                    
                    // Change Prometheus service to LoadBalancer
                    sh """
                    kubectl patch svc prometheus-kube-prometheus-prometheus -n monitoring -p '{"spec": {"type": "LoadBalancer"}}'
                    """
                }
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}
